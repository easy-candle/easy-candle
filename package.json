{
"name": "easy-candle",
  "version": "2.6.1",
  "description": "Easy Candle — Binance candle replay desktop app",
  "author": "Easy Candle",
  "license": "MIT",
  "homepage": "https://github.com/easy-candle/easy-candle",
  "repository": {
    "type": "git",
    "url": "https://github.com/easy-candle/easy-candle.git"
  },
  "bugs": {
    "url": "https://github.com/easy-candle/easy-candle/issues"
  },
  "scripts": {
    "dev": "vite",
    "dev:desktop": "tauri dev",
    "preview": "vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "yarn typecheck:node && yarn typecheck:web",
    "build:web": "vite build",
    "build": "yarn typecheck && yarn build:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "fetch-contributors": "node scripts/fetch-contributors.mjs",
    "dist": "yarn tauri build",
    "dist:win": "yarn tauri build --bundles nsis",
    "dist:mac": "yarn tauri build --bundles app,dmg",
    "dist:linux": "yarn tauri build --bundles appimage,deb"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.2.6",
    "vitest": "^3.2.4"
  },
  "resolutions": {
    "vite": "^7.2.6"
  }
}