{
  "name": "easy-candle-electron",
  "version": "2.8.0",
  "description": "Easy Candle — Binance candle replay desktop app",
  "main": "./out/main/index.js",
  "author": "Easy Candle",
  "license": "MIT",
  "homepage": "https://github.com/easy-candle/easy-candle",
  "repository": {
    "type": "git",
    "url": "https://github.com/easy-candle/easy-candle.git"
  },
  "bugs": {
    "url": "https://github.com/easy-candle/easy-candle/issues"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:desktop": "electron-vite dev",
    "dev:web": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "build:desktop": "npm run typecheck && electron-vite build",
    "build:web": "vite build",
    "start": "vite preview --port 3000 --host 0.0.0.0",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "lint": "eslint src",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch-contributors": "node scripts/fetch-contributors.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "driver.js": "^1.8.0",
    "electron-updater": "^6.6.2",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "ws": "^8.21.3",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.21",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^3.2.4"
  },
  "resolutions": {
    "vite": "^7.2.6"
  }
}
