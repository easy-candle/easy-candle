{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Easy Candle",
  "version": "2.6.1",
  "identifier": "com.easycandle.desktop",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Easy Candle",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Easy Candle — Binance candle replay desktop app",
    "longDescription": "Replay Binance candle charts in UTC, apply indicators and drawings, and paper-trade without risk.",
    "category": "Finance",
    "copyright": "Easy Candle",
    "publisher": "Easy Candle",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxMkZDRUQ3OTMxMTExClJXUVJFWlBYemkvUkFOWkUvVFRIN091M3ZZbldDWldac3ZBYXZoYnZWYzk2K016ZDBZSjZNMmY3Cg==",
      "endpoints": [
        "https://github.com/easy-candle/easy-candle/releases/latest/download/latest.json"
      ]
    }
  }
}